{
  "name": "detain/php-dup-finder",
  "description": "AST-based PHP duplicate-logic detector and refactoring assistant.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Joe Huss",
      "email": "detain@interserver.net",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/detain/php-dup-finder/issues",
    "source": "https://github.com/detain/php-dup-finder"
  },
  "require": {
    "php": "^8.3",
    "ext-hash": "*",
    "ext-gmp": "*",
    "nikic/php-parser": "^5.0",
    "symfony/console": "^6.4 || ^7.0",
    "sebastian/diff": "^5.1 || ^6.0",
    "sugarcraft/sugar-core": "dev-master",
    "sugarcraft/sugar-mouse": "dev-master",
    "sugarcraft/sugar-quickpick": "dev-master",
    "sugarcraft/sugar-cli": "dev-master",
    "sugarcraft/sugar-log": "dev-master",
    "sugarcraft/sugar-colorprofile": "dev-master",
    "sugarcraft/sugar-style": "dev-master",
    "sugarcraft/sugar-widgets": "dev-master",
    "sugarcraft/sugar-charts": "dev-master",
    "sugarcraft/sugar-navstack": "dev-master",
    "sugarcraft/sugar-forms": "dev-master",
    "sugarcraft/candy-ansi-inspect": "dev-master",
    "sugarcraft/sugar-flexbox": "dev-master",
    "sugarcraft/sugar-table": "dev-master",
    "sugarcraft/sugar-toast": "dev-master",
    "sugarcraft/sugar-overlay": "dev-master"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "vimeo/psalm": "6.0.0"
  },
  "suggest": {
    "sugarcraft/candy-scriptui": "spin/choose/filter/confirm CLI helpers for shell-script integration",
    "sugarcraft/candy-ssh-launcher": "Example SSH endpoint picker app illustrating SugarCraft component usage"
  },
  "autoload": {
    "psr-4": {
      "Phpdup\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Phpdup\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/phpdup"
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-core"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-mouse"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-quickpick"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-cli"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-log"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-colorprofile"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-style"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-spring"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-widgets"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-charts"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-navstack"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-forms"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/candy-ansi-inspect"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-flexbox"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-table"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-toast"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-overlay"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-ansi-parser"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-async"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-cellbuffer"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-fuzzy"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-input"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-constraints"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-pty"
    },
    {
      "type": "vcs",
      "url": "https://github.com/sugarcraft/sugar-dashboard"
    }
  ],
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "analyze": "bin/phpdup analyze",
    "build:phar": "php -d phar.readonly=0 build-phar.php",
    "verify:phar": "sha256sum phpdup.phar && php phpdup.phar --version"
  }
}
