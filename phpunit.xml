<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- once-S98 (php-dup-finder-once-123, XP-10): src-attributed PHP
     deprecations now FAIL the battery (failOnDeprecation on the runner;
     restrictDeprecations scopes consideration to the <source> whitelist
     below — the "ignore list scoped to vendor/" posture, so
     vendor/sugarcraft dev-master drift is named-but-not-failed).
     failOnWarning/failOnNotice are the once-S93 vacuity-sweep era
     posture and stay SACRED: this change only tightens. The network
     group's CI exclusion lives in the ci.yml legs' exclude-group
     flags (once-S93 era), not in this file. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true" failOnNotice="true" failOnDeprecation="true">
  <php>
    <!-- Ini-hermeticity (owner steer 2026-11-21): pin the float serializer
         so JSON bytes written by golden regeneration and read by consumers
         are identical regardless of the box's php.ini. The whole-float
         rendering axis is additionally closed by Num::json (whole values
         emit as int bytes on every version); this pin protects the
         remaining non-whole floats (sp=17 would print 0.8333 as
         0.83329999999999995). -1 = shortest round-trip. -->
    <ini name="serialize_precision" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="Unit">
      <directory>tests/Unit</directory>
    </testsuite>
    <testsuite name="Integration">
      <directory>tests/Integration</directory>
    </testsuite>
    <testsuite name="Golden">
      <directory>tests/Golden</directory>
    </testsuite>
    <testsuite name="Fuzz">
      <directory>tests/Fuzz</directory>
    </testsuite>
  </testsuites>
  <source restrictDeprecations="true">
    <include>
      <directory>src</directory>
    </include>
  </source>
</phpunit>
