<?php
// output-S53 strictkit unit (fixture contract, see ../README.md): a
// strict_types member whose shared typed formals ($count, $tag) are
// promoted through apply (S49b) while the literal 'ALPHA' inside the
// matched call statement is the required hole whose per-member row is
// re-bound at the rewritten call site (S45). The rewrite must PRESERVE the
// declare directive at the top of the member file, and the child-php smoke
// executes the whole chain under strict typing.
declare (strict_types=1);

function tallyRow(int $count, string $tag): int
{
    seedCounter();

    return $count + checkGate('ALPHA');
}
