#!/usr/bin/env php
<?php
declare(strict_types=1);
/**
 * Entry point for the background analysis worker.
 *
 * This script is spawned by ServeCommand and runs as a subprocess.
 * It listens on a Unix domain socket for job dispatch messages and
 * processes analysis requests asynchronously.
 *
 * Usage:
 *   php bin/phpdup-worker <socket-path> <result-dir> [<serve-root>]
 *
 * Wire protocol:
 *   Receives: RUN <jobId> <configJson>
 *   Responds:  OK <jobId>  or  FAIL <jobId> <error>
 *
 * The optional <serve-root> token re-declares the confinement boundary
 * inside the worker process itself: dispatched jobs are re-validated
 * against it before the pipeline runs (defence in depth). Omitting it
 * disables worker-side confinement (manual/dev spawns only — ServeCommand
 * always passes it).
 *
 * Lifecycle: the worker terminates itself once the daemon that spawned
 * it dies — ServeCommand hands its own pid down through the
 * PHPDUP_SERVE_PID environment token, and the worker's per-iteration
 * poll treats that pid vanishing (or this process being reparented) as
 * daemon death, unlinking its socket on the way out (see AnalysisWorker).
 * Without ext-posix, without the env token (manual/dev spawns), or when
 * spawned directly under init, the poll degrades to a no-op (same
 * graceful posture as WorkerPool's serial fallback without pcntl);
 * ServeCommand's bounded tree reap still covers every path that has a
 * live parent.
 *
 * Death paths (once-S44, php-dup-finder-once-048): this entry installs
 * SIGINT/SIGTERM handlers that stop the loop, so a targeted kill or a
 * terminal Ctrl-C routes through AnalysisWorker::run()'s single exit
 * funnel — the loop ends, the worker's own socket file is unlinked —
 * instead of dying mid-scan with the socket left serving to nobody.
 * Where pcntl is unavailable the install is the documented graceful
 * no-op and the default dispositions stand. SIGKILL/OOM still admits no
 * handler: that leftover socket is CLASSIFIED, never trusted, on the
 * next bind — the worker (and ServeCommand pre-spawn) probe the path
 * with a zero-byte connect and reclaim it only after proving no live
 * listener, so restart-after-`kill -9` cannot wedge on stale litter and
 * a live worker's socket is never silently stolen.
 */

$autoloads = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];
$loaded = false;
foreach ($autoloads as $file) {
    if (is_file($file)) {
        require $file;
        $loaded = true;
        break;
    }
}
if (!$loaded) {
    fwrite(STDERR, "phpdup-worker: composer autoload not found. Run `composer install` in the project root.\n");
    exit(1);
}

array_shift($argv);
$scriptName = array_shift($argv);

if ($scriptName === null || $scriptName === '--help' || $scriptName === '-h') {
    echo "Usage: phpdup-worker <socket-path> <result-dir> [<serve-root>]\n";
    echo "\n";
    echo "Background worker that processes phpdup analysis jobs.\n";
    echo "\n";
    echo "Arguments:\n";
    echo "  socket-path  Path to the Unix domain socket for receiving jobs\n";
    echo "  result-dir   Directory where result files are stored\n";
    echo "  serve-root   Optional confinement root; dispatched job paths are\n";
    echo "               re-validated against it (ServeCommand always passes it)\n";
    exit($scriptName === null ? 0 : 1);
}

$socketPath = $scriptName;
$resultDir = array_shift($argv);
$serveRoot = array_shift($argv);
if ($serveRoot === '') {
    $serveRoot = null;
}

if ($socketPath === null || $socketPath === '') {
    fwrite(STDERR, "phpdup-worker: socket-path is required\n");
    exit(1);
}

if ($resultDir === null || $resultDir === '') {
    $resultDir = sys_get_temp_dir();
}

if (!is_dir($resultDir) || !is_writable($resultDir)) {
    fwrite(STDERR, "phpdup-worker: result-dir is not writable: {$resultDir}\n");
    exit(1);
}

if ($serveRoot !== null && !is_dir($serveRoot)) {
    fwrite(STDERR, "phpdup-worker: serve-root is not a directory: {$serveRoot}\n");
    exit(1);
}

try {
    // Spawn env token from ServeCommand (shell-016): the daemon's own
    // pid, the worker's authoritative daemon-liveness reference. Absent
    // or non-numeric on manual/dev spawns — the poll simply loses that
    // leg and keeps the reparent belt.
    $servePidRaw = getenv(\Phpdup\Cli\ServeCommand::WORKER_PID_ENV);
    $worker = new \Phpdup\Server\AnalysisWorker(
        $socketPath,
        $resultDir,
        $serveRoot,
        servePid: is_numeric($servePidRaw) ? (int)$servePidRaw : null
    );

    // once-S44 (php-dup-finder-once-048): a death-path handler for the
    // worker's OWN signals. stop() only flips a bool — all real cleanup
    // rides run()'s single exit funnel (unlink the socket, return) — the
    // same discipline as the watchdog legs. pcntl_async_signals makes
    // the verdict land inside the blocked accept instead of waiting for
    // the next loop poll. Where pcntl is unavailable this is the
    // documented graceful no-op; the daemon's bounded tree reap and the
    // probe-then-reclaim bind leg stand behind it exactly as before.
    if (function_exists('pcntl_signal') && function_exists('pcntl_async_signals')
        && defined('SIGINT') && defined('SIGTERM')) {
        pcntl_async_signals(true);
        $stopOnSignal = static function () use ($worker): void {
            $worker->stop();
        };
        pcntl_signal(SIGINT, $stopOnSignal);
        pcntl_signal(SIGTERM, $stopOnSignal);
    }

    $worker->run();
} catch (\Throwable $e) {
    fwrite(STDERR, "phpdup-worker: fatal error: {$e->getMessage()}\n");
    exit(1);
}
