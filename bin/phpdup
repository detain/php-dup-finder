#!/usr/bin/env php
<?php
declare(strict_types=1);

$autoloads = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];
$loaded = false;
foreach ($autoloads as $file) {
    if (is_file($file)) {
        require $file;
        $loaded = true;
        break;
    }
}
if (!$loaded) {
    fwrite(STDERR, "phpdup: composer autoload not found. Run `composer install` in the project root.\n");
    exit(1);
}

use Symfony\Component\Console\Application;
use Phpdup\Cli\Command;
use Phpdup\Cli\CompletionCommand;
use Phpdup\Cli\InitCommand;
use Phpdup\Cli\ServeCommand;
use Phpdup\Cli\UpdateCommand;

$app = new Application('phpdup', '0.1.0');
$cmd = new Command();
$app->add($cmd);
// `phpdup init` — bootstrap a phpdup.json in the current directory.
$app->add(new InitCommand());
// self:update / upgrade / self-update — registered as aliases in UpdateCommand.
$app->add(new UpdateCommand());
// Override Symfony Console's default `completion` command with our own that
// prepends commented-out shell-specific install instructions to the script.
$app->add(new CompletionCommand());
// `phpdup serve` — minimal HTTP analysis server.
$app->add(new ServeCommand());
$app->setDefaultCommand($cmd->getName(), false);

// once-S19 (php-dup-finder-once-022): make the documented default-command
// form real. Symfony's singleCommand mode (the true second argument of
// setDefaultCommand) routes EVERY invocation to the default command —
// Application::getCommandName() short-circuits on it — which would make
// init/serve/self:update unreachable. The enabled default command is
// therefore a pre-dispatch guard on $_SERVER['argv']:
//   * no arguments at all            -> show the command listing (list),
//                                       not analyze's exit-2 path door;
//   * first non-flag token not a     -> the path-as-positional form: run it
//     registered command or alias      as `analyze <token> ...`, the exact
//                                       shape the missing-path hint teaches;
//   * anything else                  -> normal dispatch, so named
//                                       sub-commands, -h/-V and flag-only
//                                       admission runs are untouched.
$argvTokens = \array_slice($_SERVER['argv'] ?? [], 1);
$firstToken = null;
foreach ($argvTokens as $token) {
    if ('' === $token || '-' !== $token[0]) {
        $firstToken = $token;
        break;
    }
}
if (null === $firstToken) {
    if ([] === $argvTokens) {
        $_SERVER['argv'][] = 'list';
    }
} elseif (!$app->has($firstToken)) {
    \array_splice($_SERVER['argv'], 1, 0, [$cmd->getName()]);
}
exit($app->run());
