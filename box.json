{
    "output": "phpdup.phar",
    "stub": "box-stub.php",
    "main": "bin/phpdup",
    "directories": [
        "src",
        "vendor"
    ],
    "files": [
        "bin/phpdup",
        "LICENSE",
        "profiles"
    ],
    "metadata": {
        "version": "0.1.0"
    },
    "compression": "gz",
    "whitelist": [
        "vendor/autoload.php",
        "vendor/composer/*",
        "vendor/nikic/php-parser/lib/**",
        "vendor/symfony/console/**",
        "vendor/symfony/polyfill-*",
        "vendor/sebastian/diff/**",
        "vendor/sugarcraft/sugar-core/**",
        "vendor/sugarcraft/sugar-quickpick/**",
        "vendor/sugarcraft/sugar-cli/**",
        "vendor/sugarcraft/sugar-log/**",
        "vendor/sugarcraft/sugar-colorprofile/**",
        "vendor/sugarcraft/sugar-style/**",
        "vendor/sugarcraft/sugar-widgets/**",
        "vendor/sugarcraft/sugar-charts/**",
        "vendor/sugarcraft/sugar-navstack/**",
        "vendor/sugarcraft/sugar-forms/**",
        "vendor/sugarcraft/candy-ansi-inspect/**",
        "vendor/sugarcraft/sugar-flexbox/**",
        "vendor/sugarcraft/sugar-table/**",
        "vendor/sugarcraft/sugar-toast/**",
        "vendor/sugarcraft/sugar-overlay/**"
    ],
    "exclude-dev": false,
    "exclude-composer-files": false,
    "binary-reference": "bin/phpdup",
    "application": {
        "name": "phpdup",
        "version": "0.1.0"
    }
}
